# Modo de produção (INF-08). Copie para src/.env.prod e preencha. Este arquivo só tem
# NOMES e instruções: não há valor padrão, de propósito. Subir sem uma variável
# obrigatória falha com uma mensagem dizendo qual falta. O .env.prod real nunca vai
# para o Git nem para o ZIP.

# --- Obrigatórias ---
# Chave do Django (também assina os tokens JWT): mínimo de 50 caracteres aleatórios.
# Para gerar uma:  python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=
# Hosts pelos quais o sistema é acessado, separados por vírgula, sem porta
# (ex.: o nome do servidor ou o IP; para testar neste computador, localhost).
DJANGO_ALLOWED_HOSTS=
# Banco PostgreSQL deste modo (volume próprio, separado do de desenvolvimento).
DB_DATABASE=
DB_USER=
# Senha do banco: gere outra com o mesmo comando da chave (mais curta serve).
DB_PASSWORD=

# --- Opcionais (valem os padrões abaixo se ficarem fora do arquivo) ---
# Porta publicada no computador (só o nginx publica porta). Padrão 8080, para não
# colidir com a 5173 e a 8000 do modo de desenvolvimento.
# FRONTEND_PORT_HOST=8080
# Processos e tempo máximo de cada requisição do gunicorn. Padrão: 3 e 30.
# GUNICORN_WORKERS=3
# GUNICORN_TIMEOUT=30
# Só com um proxy TLS na frente (o compose não termina HTTPS): 1 liga o redirecionamento
# para HTTPS, o HSTS e os cookies seguros. Padrão 0 (HTTP puro, uso local).
# DJANGO_HTTPS=0
# Com DJANGO_HTTPS=1: origens https:// completas do sistema, separadas por vírgula
# (necessárias para o login do /admin/ atrás do proxy).
# DJANGO_CSRF_TRUSTED_ORIGINS=
# Proxies à frente do backend (o nginx do compose conta como 1). Padrão 1.
# DJANGO_NUM_PROXIES=1
# Limites de tentativas, mesmo formato do .env.example (N/s, N/min, N/hour ou N/day).
# LIMITE_LOGIN_POR_EMAIL=5/min
# LIMITE_LOGIN_POR_IP=20/min
# LIMITE_CADASTRO_POR_IP=10/hour
# LIMITE_TROCA_DE_SENHA_POR_USUARIO=5/min
# LIMITE_GESTAO_DE_USUARIOS_POR_USUARIO=30/min
# JWT_ACCESS_MINUTES=30
# JWT_REFRESH_DAYS=1
