# Modo de produção (INF-08). O Dockerfile de desenvolvimento não muda.
# Sem requirements-dev.txt (pytest, ruff, mutmut...), sem runserver, sem --reload.
FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1
WORKDIR /app

COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt

# Usuário sem privilégios (com home, que o gunicorn usa): o servidor não roda como root.
RUN useradd --system --create-home --uid 10001 aplicacao
COPY --chown=aplicacao . .

# Estáticos do admin do Django, com o manifesto do whitenoise. O settings só usa esse
# armazenamento com o modo de produção ligado e, nele, exige valores válidos: os de baixo
# são descartáveis, valem só neste comando e não ficam na imagem.
RUN DJANGO_MODO_PRODUCAO=1 DJANGO_DEBUG=False \
    DJANGO_SECRET_KEY=valor-descartavel-so-para-o-collectstatic-do-build-0123456789 \
    DJANGO_ALLOWED_HOSTS=build DB_HOST=build DB_DATABASE=build DB_USER=build DB_PASSWORD=build \
    REDIS_URL=redis://build:6379/0 \
    python manage.py collectstatic --noinput \
    && chown -R aplicacao /app/staticfiles

USER aplicacao
EXPOSE 8000

# Workers e timeout por variável. Forma shell de propósito: expande as variáveis; o exec
# mantém o gunicorn como PID 1.
CMD exec gunicorn config.wsgi:application \
    --bind 0.0.0.0:8000 \
    --workers "${GUNICORN_WORKERS:-3}" \
    --timeout "${GUNICORN_TIMEOUT:-30}" \
    --access-logfile -
