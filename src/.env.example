# --- PostgreSQL ---
DB_DATABASE=conecta_campus
DB_USER=conecta
DB_PASSWORD=troque-esta-senha
DB_HOST=db
# Porta que o Django usa dentro da rede do Docker: deixe 5432.
DB_PORT=5432
# Porta publicada no seu computador. Se já houver um Postgres local na 5432, mude só esta (ex.: 5433).
DB_PORT_HOST=5432

# --- Portas da API e da tela no seu computador ---
# Se a 8000 estiver ocupada, mude só esta (ex.: 8001): o endereço da API usado pela tela acompanha.
BACKEND_PORT_HOST=8000
# Se a 5173 estiver ocupada, mude só esta (ex.: 5174) e abra a tela na porta nova: as origens do CORS acompanham.
FRONTEND_PORT_HOST=5173

# --- Django ---
# Também assina os tokens JWT: use pelo menos 32 caracteres aleatórios. Para gerar uma:
# python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=troque-esta-chave-por-uma-com-pelo-menos-32-caracteres
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend

# --- Autenticação JWT ---
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=1
