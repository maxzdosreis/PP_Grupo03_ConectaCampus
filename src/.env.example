# --- PostgreSQL ---
DB_DATABASE=conecta_campus
DB_USER=conecta
DB_PASSWORD=troque-esta-senha
DB_HOST=db
# Porta que o Django usa dentro da rede do Docker: deixe 5432.
DB_PORT=5432
# Porta publicada no seu computador. Se já houver um Postgres local na 5432, mude só esta (ex.: 5433).
DB_PORT_HOST=5432

# --- Portas da API e da tela no seu computador ---
# Se a 8000 estiver ocupada, mude BACKEND_PORT_HOST e a porta de VITE_API_URL juntas (ex.: 8001).
BACKEND_PORT_HOST=8000
# Se a 5173 estiver ocupada, mude FRONTEND_PORT_HOST e as portas de CORS_ALLOWED_ORIGINS juntas (ex.: 5174).
FRONTEND_PORT_HOST=5173

# --- Django ---
# Também assina os tokens JWT: use pelo menos 32 caracteres aleatórios. Para gerar uma:
# python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=troque-esta-chave-por-uma-com-pelo-menos-32-caracteres
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
# Endereços da tela que podem chamar a API pelo navegador: localhost e 127.0.0.1, na FRONTEND_PORT_HOST.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Autenticação JWT ---
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=1

# --- Frontend ---
# Endereço da API usado pelo navegador: a porta é a BACKEND_PORT_HOST.
VITE_API_URL=http://localhost:8000/api